<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
  <div class="container">

    <!-- Logo -->
    <a class="navbar-brand fw-bold" href="/">Blogify</a>

    <!-- Mobile Toggle -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavDropdown"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavDropdown">

      <!-- Left Side -->
      <ul class="navbar-nav">

        <li class="nav-item">
          <a class="nav-link active" href="/">Home</a>
        </li>

        <% if (locals.user) { %>

        <li class="nav-item">
          <a class="nav-link" href="/blog/add-new">Add Blog</a>
        </li>

        <% } %>

      </ul>

      <!-- Right Side -->
      <ul class="navbar-nav ms-auto">

        <% if (locals.user) { %>

        <li class="nav-item dropdown">

          <a
            class="nav-link dropdown-toggle fw-semibold"
            href="#"
            role="button"
            data-bs-toggle="dropdown"
          >
            <%= locals.user.fullName %>
            
          </a>

          <ul class="dropdown-menu dropdown-menu-end">

            <li>
              <a class="dropdown-item" href="/user/logout">Logout</a>
            </li>

          </ul>

        </li>

        <% } else { %>

        <li class="nav-item">
          <a class="nav-link" href="/user/signin">Sign In</a>
        </li>

        <li class="nav-item">
          <a class="btn btn-primary ms-lg-3 mt-2 mt-lg-0" href="/user/signup">
            Create Account
          </a>
        </li>

        <% } %>

      </ul>

    </div>
  </div>
</nav>

<!-- Error Alert -->
<% if (locals.error) { %>
<div class="container mt-4">
  <div class="alert alert-danger shadow-sm">
    <%= locals.error %>
  </div>
</div>
<% } %>